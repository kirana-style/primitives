// The checks' view of the fixture (`vp check`).
{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "strict": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  // Unknown props, events and components are refused, and `v-model` is checked both ways. A
  // plain element's `data-*` attributes are not props to check.
  "vueCompilerOptions": { "strictTemplates": true, "dataAttributes": ["data-*"] },
  "include": ["src", "vite.config.ts"]
}
