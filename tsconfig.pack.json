{
  // Declarations for the packed packages (`scripts/pack.ts`). The compiler settings of
  // tsconfig.json, for the packages' sources alone.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "declaration": true
  },
  "include": [
    "packages/core/src",
    "packages/react/src",
    "packages/vue/src",
    "packages/vocabulary/src"
  ],
  "exclude": ["**/*.test.ts", "**/*.test.tsx"]
}
